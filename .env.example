# Database - Neon PostgreSQL
# Get from: https://neon.tech → Create project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# GitHub OAuth App
# Get from: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

#gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Cron job protection secret — generate with: openssl rand -hex 32
CRON_SECRET=

# App URL (set to your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# Stripe API Key (for future monetization features)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=

# AI-DevOps Nexus (Agent Execution) — optional
# Connect to your Nexus instance to enable "Queue →" on advisor actions
# NEXUS_API_URL=https://your-nexus-instance.onrender.com
# NEXUS_API_TOKEN=nexus-your-service-token
# NEXUS_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32
