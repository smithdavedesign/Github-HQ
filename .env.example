# Database - Neon PostgreSQL
# Get from: https://neon.tech → Create project → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# GitHub OAuth App
# Get from: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

#gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Cron job protection secret — generate with: openssl rand -hex 32
CRON_SECRET=

# App URL (set to your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# Stripe API Key (for future monetization features)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=

# Stripe Checkout + Webhooks (required for pricing/subscription features)
STRIPE_SECRET_KEY=                  # sk_live_... or sk_test_...
STRIPE_WEBHOOK_SECRET=              # whsec_... from Stripe dashboard → Webhooks
STRIPE_PRO_PRICE_ID=                # price_... for the Pro plan monthly price
STRIPE_TEAM_PRICE_ID=               # price_... for the Team plan monthly price

# App URL — used for Stripe Checkout success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000  # set to https://yourdomain.com in production

# ─── AI-DevOps Nexus — Agent Execution (Phase 46) ───────────────────────────
# Add these to Vercel → Project → Settings → Environment Variables
#
# NEXUS_API_URL        Your Nexus Render URL (enables "Queue →" on advisor actions)
# NEXUS_API_TOKEN      Service token from Nexus INTERNAL_SERVICE_TOKENS config
# NEXUS_WEBHOOK_SECRET Shared secret — must match REPOHQ_WEBHOOK_SECRET in Nexus
#                      Generate: openssl rand -hex 32
NEXUS_API_URL=
NEXUS_API_TOKEN=
NEXUS_WEBHOOK_SECRET=

# ─── MCP Server (mcp/server.ts) ─────────────────────────────────────────────
# Required when running the MCP server for Claude Code IDE integration.
# Get your user ID: SELECT id FROM users LIMIT 1 in Neon console
MCP_USER_ID=

# ─── gstack Integration (G6) ────────────────────────────────────────────────
# Directory containing gstack-{skill}.sh execution scripts in AI-Took-My-Job.
# Defaults to the directory of AGENT_EXECUTION_COMMAND if not set.
# Set this only if your scripts live somewhere other than alongside AGENT_EXECUTION_COMMAND.
# GSTACK_SCRIPTS_DIR=/path/to/AI-Took-My-Job/scripts

# ─── gstack Shell Scripts (set in Render / worker environment, not Vercel) ──
# These are used by the Nexus worker, not the Next.js app directly.
# OPENCLAW_SESSION=true   # Suppresses interactive prompts in spawned gstack sessions
# SPAWNED_SESSION=true    # Signals orchestrator context to gstack preamble

# ─── OpenClaw Heartbeat Endpoint (Phase 57) ──────────────────────────────────
# Allows the local OpenClaw instance to queue skills via POST /api/agent/chain-skill
# without exposing the Nexus API token. Set a random secret and configure it
# in your OpenClaw heartbeat routine.
# Generate: openssl rand -hex 32
OPENCLAW_CHAIN_SECRET=
