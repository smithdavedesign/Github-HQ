# Database - Neon PostgreSQL
# Get from: https://neon.tech → Create project → Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# GitHub OAuth App
# Get from: https://github.com/settings/developers → New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Personal tool: only these GitHub logins may sign in (comma-separated). Unset = anyone.
ALLOWED_GITHUB_LOGINS=

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic Claude API Key
ANTHROPIC_API_KEY=

#gemini API Key
GEMINI_API_KEY=

# OpenAI API Key
OPENAI_API_KEY=

# Cron job protection secret — generate with: openssl rand -hex 32
CRON_SECRET=

# Encryption key for GitHub tokens and LLM API keys stored in Postgres.
# REQUIRED. Generate with: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes). Keep this secret — rotating it
# requires all users to re-authenticate and re-save their API keys.
ENCRYPTION_KEY=

# App URL (set to your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# Stripe API Key (for future monetization features)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=


# App URL — used for Stripe Checkout success/cancel redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000  # set to https://yourdomain.com in production

# ─── Agent HQ factory queue (Phase 81, docs/agent-hq-migration-prd.md) ──────
# REDIS_URL        External URL of the agent-hq-redis Key Value (render.yaml), rediss://…
#                  Local dev: docker compose up -d redis → redis://127.0.0.1:6379
#                  Optional for `next build`; without it requests still queue in Neon and the
#                  worker picks them up at its next cycle.
# FACTORY_USER_ID  Your RepoHQ user id (same value as in ~/.repohq-factory/env). Enables "Run
#                  agent" for allowlisted repos and the owner-only controls on the Agents page.
REDIS_URL=
FACTORY_USER_ID=

# ─── MCP Server (mcp/server.ts) ─────────────────────────────────────────────
# Required when running the MCP server for Claude Code IDE integration.
# Get your user ID: SELECT id FROM users LIMIT 1 in Neon console
MCP_USER_ID=

