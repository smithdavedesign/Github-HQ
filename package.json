{
  "name": "repohq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bash scripts/e2e-branch.sh",
    "test:e2e:prod-db": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && bash scripts/e2e-branch.sh",
    "test:flow": "vitest run --config vitest.flow.config.ts",
    "test:flow:e2e": "playwright test --config playwright.flow.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "dead-code": "knip",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "factory": "tsx factory/run.ts",
    "factory:worker": "tsx factory/worker.ts",
    "factory:scout": "tsx factory/scout.ts",
    "factory:report": "tsx factory/run.ts --report",
    "factory:morning": "tsx factory/report.ts",
    "factory:sandbox:build": "tsx factory/bin/build-sandbox.ts",
    "factory:sandbox:check": "tsx factory/eval/sandbox-smoke.ts",
    "factory:e2e": "bash factory/eval/e2e.sh",
    "factory:judge-fixture": "tsx factory/bin/judge-fixture.ts",
    "factory:migrate": "tsx factory/bin/migrate.ts",
    "factory:backfill-jobs": "tsx factory/bin/backfill-jobs.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neondatabase/serverless": "^1.1.0",
    "@octokit/rest": "^22.0.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "bullmq": "^5.81.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^6.41.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.0",
    "knip": "^6.16.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
